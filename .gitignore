# ==========================================================================
# .gitignore — base réutilisable pour projets .NET (moderne) et Python
# --------------------------------------------------------------------------
# Volontairement minimal : ne couvre que les outils réellement utilisés.
# Décommenter / compléter selon les besoins d'un projet donné.
# ==========================================================================

# --- Secrets & configuration locale (NE JAMAIS versionner) ----------------
# Rappel : les user-secrets .NET vivent hors du dépôt (%APPDATA%), donc déjà sûrs.
.env
.env.*
!.env.example
appsettings.*.local.json
secrets.json
*.pfx
*.p12

# --- .NET / build ---------------------------------------------------------
bin/
obj/
.vs/
*.user
*.suo
[Tt]est[Rr]esults/
*.nupkg
*.snupkg
project.lock.json

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- IDE / éditeurs -------------------------------------------------------
.vscode/          # décommenter pour partager la config VS Code : garder ce dossier
.idea/            # Rider / JetBrains

# --- Claude Code ----------------------------------------------------------
# Config perso ignorée ; la config partagée (.claude/settings.json, commands,
# agents, skills) reste versionnable. Pour un projet solo, on peut ignorer tout
# le dossier en remplaçant les 2 lignes par : .claude/
.claude/settings.local.json
.claude/**/*.local.*

# --- OS -------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
*.lnk

# --- Logs & temporaires ---------------------------------------------------
*.log
*.tmp
